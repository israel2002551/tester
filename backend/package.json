{
  "name": "@buysell/backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.18 <25"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker:outbox": "node src/worker.js",
    "build": "npm run prisma:validate && node scripts/check-syntax.mjs",
    "test": "node --test --test-reporter=spec",
    "lint": "eslint src test scripts",
    "prisma:generate": "node scripts/run-prisma.mjs generate",
    "prisma:validate": "node scripts/run-prisma.mjs validate",
    "db:migrate": "node scripts/run-prisma.mjs migrate deploy",
    "db:status": "node scripts/run-prisma.mjs migrate status",
    "db:seed": "node ../database/prisma/seed.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/s3-request-presigner": "^3.864.0",
    "@prisma/client": "6.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jose": "^6.0.13",
    "pg": "^8.16.3",
    "pino-http": "^10.5.0",
    "web-push": "^3.6.7",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "prisma": "6.14.0",
    "supertest": "^7.1.4"
  }
}
