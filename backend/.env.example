NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buysell?schema=public
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buysell?schema=public

# Supabase remains the identity provider. Use a publishable key; never put a service-role key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
ALLOW_DEV_AUTH=false

FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174
TRUST_PROXY=1
LOG_LEVEL=info

FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
PAYMENT_REDIRECT_URL=http://localhost:5173/checkout/success

PUBLIC_MEDIA_PROVIDER=cloudinary
PRIVATE_MEDIA_PROVIDER=s3
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
S3_PUBLIC_BASE_URL=

CHECKOUT_QUOTE_TTL_MINUTES=20
INVENTORY_RESERVATION_MINUTES=30
PLATFORM_COMMISSION_BPS=300
# 32-byte base64-encoded key used to encrypt payout account numbers at rest.
PAYOUT_ENCRYPTION_KEY=
MEDIA_SIGNED_URL_TTL_SECONDS=600
MEDIA_MAX_IMAGE_BYTES=10000000
MEDIA_MAX_VIDEO_BYTES=60000000
MEDIA_MAX_DOCUMENT_BYTES=15000000

RESEND_API_KEY=
EMAIL_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@buysell.ng
PROCUREMENT_SOURCE_PROVIDER=
