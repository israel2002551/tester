# Shared local defaults. Copy service-specific values into backend/.env and frontend/.env.local.
NODE_ENV=development
PORT=4000
FRONTEND_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buysell?schema=public
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buysell?schema=public

# Supabase is retained for identity only. These are project URL / publishable keys, never service-role secrets.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_DEMO_MODE=false

FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
PAYMENT_REDIRECT_URL=http://localhost:5173/checkout/success

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
S3_PUBLIC_BASE_URL=

PAYOUT_ENCRYPTION_KEY=
RESEND_API_KEY=
EMAIL_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@buysell.ng
PROCUREMENT_SOURCE_PROVIDER=

# Migration credentials are deliberately separate from runtime credentials.
SOURCE_SUPABASE_URL=
SOURCE_SUPABASE_READ_ONLY_KEY=
SOURCE_DATABASE_URL=
ALLOW_BROAD_SOURCE_CREDENTIAL=false
SEED_DEMO_DATA=false
