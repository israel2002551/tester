# BUYSELL Local Environment Configuration
# Copy this file to .env.local for Vite development or config.js

# Supabase Project API Settings (find these in your Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Admin Settings
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_EMAILS=admin@example.com,second-admin@example.com

# Payment Integration
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-your-public-key
