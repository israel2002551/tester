generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AuthProvider {
  SUPABASE
  IMPORTED
}

enum PlatformRole {
  SUPPORT_ADMIN
  CONTENT_ADMIN
  OPERATIONS_ADMIN
  SOURCING_MANAGER
  FINANCE_ADMIN
  SUPER_ADMIN
}

enum StoreStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum StoreRole {
  OWNER
  ADMIN
  MANAGER
  PRODUCT_MANAGER
  ORDER_MANAGER
  FINANCE_MANAGER
  SUPPORT_AGENT
}

enum StorePermission {
  STORE_READ
  STORE_UPDATE
  PRODUCT_READ
  PRODUCT_WRITE
  INVENTORY_WRITE
  ORDER_READ
  ORDER_FULFIL
  CUSTOMER_READ
  MESSAGE_WRITE
  FINANCE_READ
  PAYOUT_REQUEST
  STAFF_MANAGE
  AD_MANAGE
}

enum SupplierStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  PAUSED
  OUT_OF_STOCK
  REJECTED
  ARCHIVED
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum MediaAccess {
  PUBLIC
  PRIVATE
}

enum QuoteStatus {
  ACTIVE
  CONSUMED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  PAID
  PROCESSING
  READY
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  DISPUTED
  REFUND_PENDING
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum PaymentAttemptStatus {
  CREATED
  INITIALIZED
  VERIFIED
  FAILED
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum ReservationStatus {
  RESERVED
  COMMITTED
  RELEASED
  EXPIRED
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  RESERVE
  RELEASE
  SALE_COMMIT
  RETURN
  ADJUSTMENT
}

enum LedgerEntryType {
  SALE_CREDIT
  COMMISSION_DEBIT
  REFUND_DEBIT
  PAYOUT_HOLD
  PAYOUT_DEBIT
  PAYOUT_REVERSAL
  ADJUSTMENT
}

enum PayoutStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PROCESSING
  PAID
  REJECTED
  CANCELLED
}

enum ConversationType {
  DIRECT
  ORDER
  SOURCING
  SUPPORT
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

enum KycSubjectType {
  USER
  STORE
  SUPPLIER
}

enum KycStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  AWAITING_BUYER
  AWAITING_SELLER
  RESOLVED_BUYER
  RESOLVED_SELLER
  CLOSED
}

enum AdStatus {
  DRAFT
  AWAITING_PAYMENT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  PAUSED
  COMPLETED
}

enum AdEventType {
  IMPRESSION
  CLICK
}

enum SourcingStatus {
  DRAFT
  REQUEST_SUBMITTED
  UNDER_REVIEW
  MORE_INFO_REQUIRED
  QUOTE_READY
  AWAITING_PAYMENT
  PAYMENT_CONFIRMED
  PROCUREMENT_IN_PROGRESS
  PROCURED
  INTERNATIONAL_TRANSIT
  ARRIVED_IN_COUNTRY
  LOCAL_FULFILMENT
  COMPLETED
  CANCELLED
}

enum SourcePlatform {
  INTERNAL_SUPPLIER
  DIRECT_FACTORY
  EXTERNAL_MARKETPLACE
  OTHER
}

enum ServiceBookingStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum DeliveryStatus {
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

enum RfqStatus {
  DRAFT
  OPEN
  QUOTING
  AWARDED
  CLOSED
  CANCELLED
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

model User {
  id                    String                   @id @default(uuid()) @db.Uuid
  email                 String?                  @unique @db.Citext
  status                UserStatus               @default(ACTIVE)
  lastLoginAt           DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  deletedAt             DateTime?
  profile               UserProfile?
  authIdentities        AuthIdentity[]
  platformRoles         PlatformRoleAssignment[]
  storeMemberships      StoreMembership[]
  ownedStores           Store[]                  @relation("StoreOwner")
  addresses             Address[]
  cart                  Cart?
  orders                Order[]                  @relation("BuyerOrders")
  conversations         ConversationMember[]
  sentMessages          Message[]                @relation("MessageSender")
  reviews               Review[]
  notifications         Notification[]
  notificationPreference NotificationPreference?
  pushSubscriptions     PushSubscription[]
  mediaAssets           MediaAsset[]             @relation("MediaOwner")
  kycSubmissions        KycSubmission[]           @relation("KycSubmitter")
  reviewedKyc           KycSubmission[]           @relation("KycReviewer")
  openedDisputes        Dispute[]                 @relation("DisputeOpener")
  assignedDisputes      Dispute[]                 @relation("DisputeAssignee")
  disputeMessages       DisputeMessage[]
  referrals             ReferralCode[]
  referralVisits        ReferralVisit[]
  auditLogs             AuditLog[]                @relation("AuditActor")
  sourcingRequests      SourcingRequest[]         @relation("SourcingRequester")
  assignedSourcing      SourcingRequest[]         @relation("SourcingAssignee")
  supplierProfile       SupplierProfile?
  checkoutQuotes        CheckoutQuote[]
  wishlists             Wishlist[]
  serviceListings       ServiceListing[]           @relation("ServiceProvider")
  serviceBookings       ServiceBooking[]           @relation("ServiceCustomer")
  deliveryAssignments   DeliveryAssignment[]       @relation("DeliveryRider")
  updatedSettings       SiteSetting[]
  broadcastsCreated     BroadcastCampaign[]
  broadcastDeliveries   BroadcastDelivery[]
  rfqRequests           RfqRequest[]              @relation("RfqRequester")
}

model UserProfile {
  userId      String   @id @db.Uuid
  displayName String?
  firstName   String?
  lastName    String?
  phone       String?
  avatarId    String?  @db.Uuid
  location    String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar      MediaAsset? @relation("ProfileAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
}

model AuthIdentity {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  provider        AuthProvider
  providerSubject String
  providerEmail   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
}

model PlatformRoleAssignment {
  userId    String       @db.Uuid
  role      PlatformRole
  grantedBy String?      @db.Uuid
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

model Store {
  id                String            @id @default(uuid()) @db.Uuid
  ownerId           String            @db.Uuid
  slug              String            @unique
  name              String
  description       String?
  status            StoreStatus       @default(PENDING)
  logoAssetId       String?           @db.Uuid
  bannerAssetId     String?           @db.Uuid
  supportEmail      String?
  supportPhone      String?
  location          String?
  metadata          Json              @default("{}")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  owner             User              @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  logo              MediaAsset?       @relation("StoreLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)
  banner            MediaAsset?       @relation("StoreBanner", fields: [bannerAssetId], references: [id], onDelete: SetNull)
  memberships       StoreMembership[]
  products          Product[]
  storeOrders       StoreOrder[]
  ledgerAccount     LedgerAccount?
  payoutDestinations PayoutDestination[]
  coupons           Coupon[]
  adCampaigns       AdCampaign[]
  supplierConnections SupplierConnection[]
  settings            StoreSetting?

  @@index([status, createdAt])
}

model StoreSetting {
  storeId                  String   @id @db.Uuid
  notificationPreferences  Json     @default("{}")
  commerceSettings         Json     @default("{}")
  fulfilmentSettings       Json     @default("{}")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  store                    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model StoreMembership {
  id          String                      @id @default(uuid()) @db.Uuid
  storeId     String                      @db.Uuid
  userId      String                      @db.Uuid
  role        StoreRole
  status      String                      @default("ACTIVE")
  joinedAt    DateTime                    @default(now())
  store       Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user        User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions StoreMembershipPermission[]

  @@unique([storeId, userId])
  @@index([userId, status])
}

model StoreMembershipPermission {
  membershipId String          @db.Uuid
  permission   StorePermission
  membership   StoreMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([membershipId, permission])
}

model SupplierProfile {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @unique @db.Uuid
  slug         String         @unique
  displayName  String
  description  String?
  status       SupplierStatus @default(PENDING)
  country      String?
  contactEmail String?
  metadata     Json           @default("{}")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  products     SupplierProduct[]
  connections  SupplierConnection[]
  procurements SourcingProcurement[]
  rfqQuotes    RfqQuote[]
}

model SupplierConnection {
  id         String          @id @default(uuid()) @db.Uuid
  supplierId String          @db.Uuid
  storeId    String          @db.Uuid
  status     String          @default("PENDING")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  supplier   SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  store      Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([supplierId, storeId])
}

model SupplierProduct {
  id             String          @id @default(uuid()) @db.Uuid
  supplierId     String          @db.Uuid
  sku            String
  name           String
  description    String?
  costKobo       BigInt
  suggestedKobo  BigInt?
  stockQuantity  Int?
  sourceUrl      String?
  active         Boolean         @default(true)
  metadata       Json            @default("{}")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  supplier       SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, sku])
  @@index([supplierId, active])
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  parentId    String?    @db.Uuid
  slug        String     @unique
  name        String
  description String?
  active      Boolean    @default(true)
  sortOrder   Int        @default(0)
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId, active, sortOrder])
}

model Brand {
  id          String       @id @default(uuid()) @db.Uuid
  slug        String       @unique
  name        String       @unique
  logoAssetId String?      @db.Uuid
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  logo        MediaAsset?  @relation("BrandLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)
  products    Product[]

  @@index([active, name])
}

model Product {
  id               String           @id @default(uuid()) @db.Uuid
  storeId          String           @db.Uuid
  categoryId       String?          @db.Uuid
  brandId          String?          @db.Uuid
  slug             String
  name             String
  description      String?
  condition        ProductCondition @default(NEW)
  status           ProductStatus    @default(DRAFT)
  shippingFeeKobo  BigInt           @default(0)
  negotiable       Boolean          @default(false)
  metadata         Json             @default("{}")
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  store            Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  category         Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand            Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants         ProductVariant[]
  options          ProductOption[]
  media            ProductMedia[]
  reviews          Review[]
  referralConversions ReferralConversion[]
  wishlistItems    WishlistItem[]

  @@unique([storeId, slug])
  @@index([status, categoryId, createdAt])
  @@index([brandId, status])
  @@index([storeId, status])
}

model ProductOption {
  id        String               @id @default(uuid()) @db.Uuid
  productId String               @db.Uuid
  name      String
  sortOrder Int                  @default(0)
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    ProductOptionValue[]

  @@unique([productId, name])
}

model ProductOptionValue {
  id        String                      @id @default(uuid()) @db.Uuid
  optionId  String                      @db.Uuid
  value     String
  sortOrder Int                         @default(0)
  option    ProductOption               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants  ProductVariantOptionValue[]

  @@unique([optionId, value])
}

model ProductVariantOptionValue {
  variantId String             @db.Uuid
  valueId   String             @db.Uuid
  variant   ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  value     ProductOptionValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([variantId, valueId])
}

model ProductVariant {
  id             String        @id @default(uuid()) @db.Uuid
  productId      String        @db.Uuid
  sku            String
  name           String?
  priceKobo      BigInt
  compareAtKobo  BigInt?
  attributes     Json          @default("{}")
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory      InventoryItem?
  cartItems      CartItem[]
  quoteItems     CheckoutQuoteItem[]
  orderItems     OrderItem[]
  optionValues   ProductVariantOptionValue[]

  @@unique([productId, sku])
  @@index([productId, active])
}

model InventoryItem {
  variantId        String                 @id @db.Uuid
  onHand           Int                    @default(0)
  reserved         Int                    @default(0)
  reorderPoint     Int                    @default(0)
  version          Int                    @default(0)
  updatedAt        DateTime               @updatedAt
  variant          ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  reservations     InventoryReservation[]
  movements        InventoryMovement[]
}

model InventoryReservation {
  id          String            @id @default(uuid()) @db.Uuid
  inventoryId String            @db.Uuid
  orderId     String            @db.Uuid
  orderItemId String            @unique @db.Uuid
  quantity    Int
  status      ReservationStatus @default(RESERVED)
  expiresAt   DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  inventory   InventoryItem     @relation(fields: [inventoryId], references: [variantId], onDelete: Restrict)
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([orderId])
}

model InventoryMovement {
  id               String                @id @default(uuid()) @db.Uuid
  inventoryId      String                @db.Uuid
  type             InventoryMovementType
  onHandDelta      Int                   @default(0)
  reservedDelta    Int                   @default(0)
  referenceType    String?
  referenceId      String?
  actorId          String?               @db.Uuid
  note             String?
  createdAt        DateTime              @default(now())
  inventory        InventoryItem         @relation(fields: [inventoryId], references: [variantId], onDelete: Restrict)

  @@index([inventoryId, createdAt])
  @@index([referenceType, referenceId])
}

model MediaAsset {
  id              String       @id @default(uuid()) @db.Uuid
  ownerId         String       @db.Uuid
  provider        String
  providerAssetId String       @unique
  kind            MediaKind
  mimeType        String
  bytes           Int
  width           Int?
  height          Int?
  durationMs      Int?
  access          MediaAccess
  publicUrl       String?
  metadata        Json         @default("{}")
  createdAt       DateTime     @default(now())
  owner           User         @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  profileAvatars  UserProfile[] @relation("ProfileAvatar")
  storeLogos      Store[]       @relation("StoreLogo")
  storeBanners    Store[]       @relation("StoreBanner")
  products        ProductMedia[]
  messages        Message[]
  kycDocuments    KycDocument[]
  disputeEvidence DisputeEvidence[]
  sourcingItems   SourcingItem[]
  adCampaigns     AdCampaign[]
  brandLogos      Brand[]       @relation("BrandLogo")
  serviceListings ServiceListing[]

  @@index([ownerId, access])
}

model ProductMedia {
  productId String     @db.Uuid
  assetId   String     @db.Uuid
  sortOrder Int        @default(0)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset     MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([productId, assetId])
  @@index([productId, sortOrder])
}

model Address {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  recipientName String
  phone         String
  line1         String
  line2         String?
  city          String
  state         String
  postalCode    String?
  country       String   @default("Nigeria")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotes        CheckoutQuote[]

  @@index([userId, isDefault])
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @db.Uuid
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @db.Uuid
  variantId String         @db.Uuid
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model Wishlist {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  name      String         @default("Saved items")
  isDefault Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]

  @@unique([userId, name])
  @@index([userId, isDefault])
}

model WishlistItem {
  wishlistId String   @db.Uuid
  productId  String   @db.Uuid
  createdAt  DateTime @default(now())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([wishlistId, productId])
  @@index([productId])
}

model CheckoutQuote {
  id                    String              @id @default(uuid()) @db.Uuid
  userId                String              @db.Uuid
  addressId             String              @db.Uuid
  status                QuoteStatus         @default(ACTIVE)
  currency              String              @default("NGN")
  subtotalKobo          BigInt
  shippingKobo          BigInt
  discountKobo          BigInt              @default(0)
  platformFeeKobo       BigInt              @default(0)
  totalKobo             BigInt
  couponId              String?             @db.Uuid
  deliveryMethod        String
  pricingVersion        String
  expiresAt             DateTime
  consumedAt            DateTime?
  createdAt             DateTime            @default(now())
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  address               Address             @relation(fields: [addressId], references: [id], onDelete: Restrict)
  coupon                Coupon?             @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items                 CheckoutQuoteItem[]
  order                 Order?

  @@index([userId, status, expiresAt])
}

model CheckoutQuoteItem {
  id               String         @id @default(uuid()) @db.Uuid
  quoteId          String         @db.Uuid
  variantId        String         @db.Uuid
  storeId          String         @db.Uuid
  productName      String
  variantName      String?
  sku              String
  unitPriceKobo    BigInt
  shippingUnitKobo BigInt
  quantity         Int
  quote            CheckoutQuote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([quoteId, variantId])
  @@index([storeId])
}

model Order {
  id                String          @id @default(uuid()) @db.Uuid
  orderNumber       String          @unique
  idempotencyKey    String          @unique
  buyerId           String          @db.Uuid
  quoteId           String          @unique @db.Uuid
  status            OrderStatus     @default(PENDING_PAYMENT)
  paymentStatus     PaymentStatus   @default(PENDING)
  currency          String          @default("NGN")
  subtotalKobo      BigInt
  shippingKobo      BigInt
  discountKobo      BigInt          @default(0)
  platformFeeKobo   BigInt          @default(0)
  totalKobo         BigInt
  deliveryMethod    String
  addressSnapshot   Json
  placedAt          DateTime        @default(now())
  paidAt            DateTime?
  cancelledAt       DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  buyer             User            @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  quote             CheckoutQuote   @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  storeOrders       StoreOrder[]
  items             OrderItem[]
  events            OrderStatusEvent[]
  payments          Payment[]
  reservations      InventoryReservation[]
  conversations     Conversation[]
  disputes          Dispute[]

  @@index([buyerId, createdAt])
  @@index([status, createdAt])
}

model StoreOrder {
  id                String       @id @default(uuid()) @db.Uuid
  orderId           String       @db.Uuid
  storeId           String       @db.Uuid
  status            OrderStatus  @default(PENDING_PAYMENT)
  subtotalKobo      BigInt
  shippingKobo      BigInt
  discountKobo      BigInt       @default(0)
  platformFeeKobo   BigInt       @default(0)
  commissionKobo    BigInt       @default(0)
  sellerNetKobo     BigInt       @default(0)
  totalKobo         BigInt
  trackingNumber    String?
  trackingNote      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  store             Store        @relation(fields: [storeId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  ledgerEntries     LedgerEntry[]
  delivery          DeliveryAssignment?

  @@unique([orderId, storeId])
  @@index([storeId, status, createdAt])
}

model OrderItem {
  id                String              @id @default(uuid()) @db.Uuid
  orderId           String              @db.Uuid
  storeOrderId      String              @db.Uuid
