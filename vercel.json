{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self), payment=(self), interest-cohort=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://cdnjs.cloudflare.com https://js.paystack.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' https: data: blob:; media-src 'self' https: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.paystack.co; frame-src https://*.paystack.co; manifest-src 'self' data: blob:; form-action 'self'; upgrade-insecure-requests" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/products", "destination": "/products.html" },
    { "source": "/upcoming", "destination": "/upcoming.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/marketing", "destination": "/marketing.html" },
    { "source": "/category-trending", "destination": "/category-trending.html" },
    { "source": "/category-phones", "destination": "/category-phones.html" },
    { "source": "/category-fashion", "destination": "/category-fashion.html" },
    { "source": "/category-home", "destination": "/category-home.html" },
    { "source": "/category-electronics", "destination": "/category-electronics.html" },
    { "source": "/category-beauty", "destination": "/category-beauty.html" },
    { "source": "/category-sports", "destination": "/category-sports.html" },
    { "source": "/category-dropship", "destination": "/category-dropship.html" },
    { "source": "/category/trending", "destination": "/category-trending.html" },
    { "source": "/category/phones", "destination": "/category-phones.html" },
    { "source": "/category/fashion", "destination": "/category-fashion.html" },
    { "source": "/category/home", "destination": "/category-home.html" },
    { "source": "/category/electronics", "destination": "/category-electronics.html" },
    { "source": "/category/beauty", "destination": "/category-beauty.html" },
    { "source": "/category/sports", "destination": "/category-sports.html" },
    { "source": "/category/dropship", "destination": "/category-dropship.html" }
  ]
}
