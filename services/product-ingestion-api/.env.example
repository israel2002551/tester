# Required server-side Supabase credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared HMAC secret used by Bot 2 and Bot 3. Generate a long random value.
INGESTION_HMAC_SECRET=replace-with-a-long-random-secret

# Marketplace seller profiles used by imported listings
WHATSAPP_LISTINGS_SELLER_ID=
TELEGRAM_LISTINGS_SELLER_ID=

# Storage and listing behaviour
PRODUCT_MEDIA_BUCKET=product-media
INGESTION_PRICE_MARKUP_PERCENT=20
WHATSAPP_LISTING_SHIPPING_FEE=2500
INGESTION_DEFAULT_LOCATION=Nigeria
INGESTION_ALLOWED_MEDIA_HOSTS=res.cloudinary.com
MAX_INGEST_MEDIA_BYTES=8388608
MAX_INGEST_REQUEST_BYTES=12000000

# Optional OpenAI-compatible vision fallback. It is called only when a title
# or description is missing; it never invents a missing price.
VISION_API_KEY=
VISION_API_BASE_URL=https://api.groq.com/openai/v1
VISION_MODEL=llama-3.2-11b-vision-preview

# Optional Bot 3 relay. Configure both values to notify its catalog chat when
# a WhatsApp product has been accepted.
BOT3_RELAY_URL=
BOT3_RELAY_SECRET=
PUBLIC_SITE_URL=https://your-buysell-site.com
