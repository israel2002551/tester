# BUYSELL Supabase project. Use the public anon/publishable key only; the
# collector authenticates its privileged requests with WHATSAPP_INGEST_SECRET.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
WHATSAPP_INGEST_SECRET=generate-a-long-random-secret

# Existing BUYSELL Cloudinary account. These credentials remain on the private
# worker host and are never included in the browser build.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Groq parser key.
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile

# Approved WhatsApp group IDs are managed from the BUYSELL Super Admin dashboard.
# Do not put group IDs in this file. The collector refreshes that private
# allow-list from BUYSELL automatically.

# The public deployed BUYSELL URL used in seller notifications.
PUBLIC_SITE_URL=https://your-buysell-domain.example

# Protect the worker from unexpectedly large media downloads.
MAX_MEDIA_BYTES=26214400
