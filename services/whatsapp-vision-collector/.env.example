# BUYSELL Supabase project credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
WHATSAPP_INGEST_SECRET=generate-a-long-random-secret

# Optional shared cross-platform API. When set, final listings are written by
# this service while the existing WhatsApp staging queue remains in place.
INGESTION_API_URL=
INGESTION_HMAC_SECRET=

# Cloudinary credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Groq Vision Key (Create free at: https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b

# Public site URL used in seller confirmation links
PUBLIC_SITE_URL=https://your-buysell-site.com

# Max media download size (25MB)
MAX_MEDIA_BYTES=26214400

# WhatsApp phone number for pairing Bot 2 (e.g. 2348012345678)
WHATSAPP_PHONE_NUMBER=

# Directory for Baileys authentication files. Set this to a persistent disk
# location in production; do not commit the directory or its contents.
SESSION_DIR=./wa_vision_auth_session

# Where the WhatsApp session lives: "file" (SESSION_DIR) or "supabase".
# Use "supabase" on hosts without a persistent disk (Render free) so restarts and
# redeploys keep the link. Values are encrypted with WHATSAPP_AUTH_ENCRYPTION_KEY
# before they leave the bot; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep the key secret and stable: changing it makes the stored session unreadable.
WHATSAPP_AUTH_STORE=file
WHATSAPP_AUTH_SESSION_ID=bot2
WHATSAPP_AUTH_ENCRYPTION_KEY=

# Automatically monitor all groups without manual approval
WHATSAPP_MONITOR_ALL_GROUPS=true

# Ordered intake, durable job worker, and retry settings. Incoming messages are
# accepted immediately; expensive downloads, vision, and imports run in queues.
WHATSAPP_MEDIA_INTAKE_CONCURRENCY=2
WHATSAPP_STAGING_CONCURRENCY=2
WHATSAPP_LISTING_WORKER_CONCURRENCY=1
WHATSAPP_QUEUE_POLL_MS=3000
WHATSAPP_PRICE_FOLLOWUP_WINDOW_MS=600000

# Transcribe spoken product details/prices from video before analysis.
WHATSAPP_TRANSCRIBE_VIDEO_AUDIO=true
MAX_AUDIO_TRANSCRIBE_BYTES=24000000
